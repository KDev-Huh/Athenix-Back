# Server
SERVER_CONTEXT_PATH=/api/v1

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/athenix?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# H2 Console (local only)
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# JPA (local only)
JPA_DDL_AUTO=create-drop
JPA_SHOW_SQL=true
JPA_DIALECT=org.hibernate.dialect.H2Dialect
JPA_FORMAT_SQL=true
JPA_USE_SQL_COMMENTS=true

# File Upload
STORAGE_PATH=./uploads
STORAGE_MAX_FILE_SIZE=1073741824
MULTIPART_MAX_FILE_SIZE=10GB
MULTIPART_MAX_REQUEST_SIZE=10GB

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# AI Server
AI_SERVER_URL=http://10.150.1.145:8000
AI_ENDPOINT_RECOMMEND=/ai/recommend/image
